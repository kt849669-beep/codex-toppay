{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "top-payy-online",
  "account_id": "e78d9d36459fc3337a335673a3638063",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "build": {
    "command": "npm run build"
  }
}
